# Optional AI investigation only. Never commit the real .env.
# Set true only when ready to send a bounded case fragment to the configured API.
AI_ENABLED=false
# Server-side API key. Leave blank in this example.
AI_API_KEY=
# OpenAI-compatible Chat Completions API base; HTTPS only, no query parameters.
AI_BASE_URL=https://api.openai.com/v1
# Exact model ID from your provider. There is deliberately no default model.
AI_MODEL=
# Total investigation deadline, including HTTP retries and tools: 1..180 seconds.
AI_TIMEOUT_SECONDS=60
# All read-only calls, including initial profile: 3..12.
AI_MAX_TOOL_CALLS=8
# Per response output budget: 512..8000. At most 3 model responses plus 2 HTTP retries.
AI_MAX_OUTPUT_TOKENS=3000
